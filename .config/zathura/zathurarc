# Gruvbox Dark (matched to foot)
set selection-clipboard clipboard

set default-bg                  "#282828"
set default-fg                  "#f2e5bc"

set statusbar-fg                "#f2e5bc"
set statusbar-bg                "#3c3836"

set inputbar-bg                 "#282828"
set inputbar-fg                 "#83a598"

set notification-bg             "#282828"
set notification-fg             "#83a598"

set notification-error-bg       "#282828"
set notification-error-fg       "#fb4934"

set notification-warning-bg     "#282828"
set notification-warning-fg     "#fabd2f"

set completion-bg               "#3c3836"
set completion-fg               "#83a598"

set index-bg                    "#282828" # Background
set index-fg                    "#f2e5bc" # Foreground
set index-active-fg             "#f2e5bc" # Current line text
set index-active-bg             "#504945" # Current line background

set completion-highlight-fg     "#b8bb26"
set completion-highlight-bg     "#3c3836"

set recolor-lightcolor          "#282828"
set recolor-darkcolor           "#f2e5bc"

set recolor                     "false"
set recolor-keephue             "false"
set font "Jetbrains Mono 11"
